NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/rbac_food_delivery
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
CORS_ORIGIN=http://localhost:4200
# Razorpay (PaymentGateway implementation) — required, no default; get test keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_changeme
RAZORPAY_KEY_SECRET=changeme-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=changeme-razorpay-webhook-secret
# Notification channels (Phase 10) — all OPTIONAL; unset = console-log fallback (dev/foundation mode).
FIREBASE_SERVICE_ACCOUNT_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMS_PROVIDER_API_URL=
SMS_PROVIDER_API_KEY=
NOTIFICATION_MAX_RETRY_ATTEMPTS=5

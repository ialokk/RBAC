# Copy to android/keystore.properties (git-ignored, never commit) and fill in real values.
# Generate a release keystore once, e.g.:
#   keytool -genkeypair -v -keystore rbac-release.jks -alias rbac -keyalg RSA -keysize 2048 -validity 10000
storeFile=../rbac-release.jks
storePassword=changeme-store-password
keyAlias=rbac
keyPassword=changeme-key-password

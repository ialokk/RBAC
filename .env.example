# Copy to `.env` and fill in real values. Never commit `.env` (see .gitignore).
# Consumed by docker-compose.yml — apps/api/.env.example documents the full set (incl. optional
# notification-channel vars) for running the API directly without Docker.
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
CORS_ORIGIN=http://localhost:8080
RAZORPAY_KEY_ID=rzp_test_changeme
RAZORPAY_KEY_SECRET=changeme-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=changeme-razorpay-webhook-secret
